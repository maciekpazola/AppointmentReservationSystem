{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "rootDir": ".",
    "outDir": "./dist",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,

    "types": [
      "node",
      "jest"
    ],

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}